# Anthropic (AI extraction)
ANTHROPIC_API_KEY=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_CONVEX_URL=

# OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Polar Billing (set in Convex dashboard for production)
POLAR_ACCESS_TOKEN=
POLAR_ENVIRONMENT=sandbox
POLAR_MAX_PRODUCT_ID=
POLAR_PRO_PRODUCT_ID=
POLAR_WEBHOOK_SECRET=

# PostHog (analytics)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=

# Resend (email notifications)
RESEND_API_KEY=

# Web push. Generate a pair with: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY and VAPID_SUBJECT are read inside Convex actions, so set
# them in the Convex dashboard too. NEXT_PUBLIC_VAPID_PUBLIC_KEY is the same
# value as VAPID_PUBLIC_KEY — the browser needs it to subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=

# Scraper API
SCRAPER_API_KEY=
SCRAPER_URL=http://localhost:3001

# Site URL (used for auth redirects and Polar checkout)
SITE_URL=http://localhost:3000

# Google Search Console (optional)
# GOOGLE_SITE_VERIFICATION=
