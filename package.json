{
  "name": "prowl",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "build:production": "pnpm --filter @prowl/web exec convex deploy --cmd 'turbo build'",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=@prowl/web",
    "dev:scraper": "turbo dev --filter=@prowl/scraper",
    "test": "turbo test"
  },
  "devDependencies": {
    "turbo": "^2.11.2",
    "typescript": "^5.9.3"
  }
}
